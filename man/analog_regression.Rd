pred_result <- analog_regression(
  x = future_sites,
  pool = sites,
  y = sites$income,
  covariates   = data.frame(education = sites$edu),       # at pool
  x_covariates = data.frame(education = future_sites$edu) # at focals
)
head(pred_result[, c("coef_intercept", "coef_education", "pred")])
}

